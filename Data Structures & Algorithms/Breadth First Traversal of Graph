    visited[v]=true;
    q.add(v);
    
    while(!q.isEmpty()){
        int node = q.poll();
        System.out.print(node+" ");
        for(int n:adjVertices.get(node)){
            if(!visited[n]){
                visited[n]=true;
                q.add(n);
